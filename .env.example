# USPEX PRO DESK V12.2.1 — BYBIT DEMO ONLY
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

XAI_API_KEY=
XAI_MODEL=grok-4.5
# Council votes: fast model required (VPS measured ~0.7–1.0s). Do NOT use grok-4.6 for votes.
XAI_VOTE_MODEL=grok-4-1-fast-non-reasoning
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=

CURSOR_API_KEY=
CURSOR_MODEL=auto
CURSOR_AGENT_BIN=
# Council vote timeout (seconds). Cursor CLI on VPS is ~9–10s; budget is 12s.
CURSOR_TIMEOUT=11
# Hard timeout for Cursor CLI process spawn only (separate from vote read timeout).
CURSOR_SPAWN_TIMEOUT_SEC=3

BYBIT_DEMO=true
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Shadow: full pipeline, zero orders
USPEX_SHADOW_MODE=1

# Exit / TP1 (optional overrides)
TP1_CLOSE_FRACTION=0.22
EXCHANGE_RECONCILE_GRACE_SEC=20
EXCHANGE_MISSING_CONFIRMATIONS=4
