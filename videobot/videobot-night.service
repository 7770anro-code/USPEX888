[Unit]
Description=DEPRECATED — VideoBot auto pipeline lives in videobot.service, do not enable this unit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=videobot
Group=videobot
WorkingDirectory=/opt/videobot
EnvironmentFile=/opt/videobot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/videobot/venv/bin/python /opt/videobot/night_runner.py
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
