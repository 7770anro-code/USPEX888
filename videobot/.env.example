# VideoBot — секреты. Файл на сервере: /opt/videobot/.env
# Имена переменных фиксированы, не переименовывать.

XAI_API_KEY_NEW=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
VIDEOBOT_TELEGRAM_TOKEN=
FAL_API_KEY=
# тот же ключ, другое имя (достаточно одного):
# FAL_KEY=

# fal.ai — единый провайдер видео (Kling 3.0 + Seedance 2.5), Topaz, примерка.
# Ключ: https://fal.ai/dashboard/keys  (не придумывать значение)
# VIDEO_PROVIDER=fal
# Быстро = Seedance 2.5, Оптимально = Kling 3.0 Pro. Переопределение модели:
# FAL_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# Mini App (HTTPS снаружи, nginx → WEBAPP_HOST:WEBAPP_PORT):
# WEBAPP_PUBLIC_URL=https://example.com/studio
# WEBAPP_PORT=8088
# WEBAPP_HOST=127.0.0.1

# Google AI Studio — Nano Banana (Gemini 2.5 Flash Image).
# Отдельный ключ, не Runway. Перед анимацией своего фото кадр чистится здесь,
# уже этот кадр идёт в I2V (меньше искажений лица). Без ключа — старый путь.
# Ключ: https://aistudio.google.com/apikey  (Create API key)
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Опционально
XAI_MODEL=grok-4.5
XAI_CREATIVE_MODEL=grok-4.5
XAI_FALLBACK_MODEL=grok-4-1-fast-non-reasoning
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
RUNWAY_MODEL=gen4.5
# Опционально, не в UI. Живой A/B: gemini_image3_pro дороже без явного выигрыша.
# RUNWAY_STILL_MODEL=gemini_image3_pro
# RUNWAY_MODEL=veo3.1_fast
# RUNWAY_MODEL=seedance2_5
RUNWAY_RATIO=720:1280
RUNWAY_VERSION=2024-11-06
RUNWAY_POLL_SEC=5
RUNWAY_TIMEOUT_SEC=720
# Model Router (выкл по умолчанию). Конфиг: https://dev.runwayml.com/model-routers
# Allow-list: gen4.5 + gen4_turbo; optimizeFor=quality; потолок ~150 кредитов/ролик.
# RUNWAY_USE_MODEL_ROUTER=0
# RUNWAY_ROUTER_CONFIG_ID=
HTTP_RETRIES=4
KEEP_FAILED_DIR=1
BURN_SUBTITLES=1
DEFAULT_STYLE=cinematic
WATERMARK_TEXT=VideoBot
# WATERMARK_LOGO=/opt/videobot/logo.png
WORK_DIR=/tmp/videobot
VIDEOBOT_DATA_DIR=/opt/videobot/data

# Автоконтур idea→video внутри videobot.service (не отдельный timer)
VIDEOS_PER_NIGHT=3
NIGHT_IDEAS_PER_NIGHT=8
NIGHT_INTERVAL_MINUTES=90
NIGHT_BATCH_PER_TICK=1
NIGHT_BACKGROUND=1
NIGHT_RUNWAY_DAILY_BUDGET=0
NIGHT_AUTOPOST=0
NIGHT_REQUIRE_CONFIRM=1
NIGHT_MODERATION_STOP=3
NIGHT_OWNER_CHAT_ID=
NIGHT_TIKTOK_MODE=inbox
NIGHT_PUBLIC_VIDEO_BASE_URL=
NIGHT_GRAPH_VERSION=v21.0
NIGHT_POST_PAUSE_MIN=90
NIGHT_POST_PAUSE_MAX=240

# Три аккаунта. Токены вводит владелец после OAuth / App Review.
NIGHT_ACC1_ID=motiv
NIGHT_ACC1_THEME=motivational
NIGHT_ACC1_TIKTOK_ACCESS_TOKEN=
NIGHT_ACC1_IG_USER_ID=
NIGHT_ACC1_IG_ACCESS_TOKEN=
NIGHT_ACC2_ID=absurd
NIGHT_ACC2_THEME=absurd
NIGHT_ACC2_TIKTOK_ACCESS_TOKEN=
NIGHT_ACC2_IG_USER_ID=
NIGHT_ACC2_IG_ACCESS_TOKEN=
NIGHT_ACC3_ID=brand
NIGHT_ACC3_THEME=mixed
NIGHT_ACC3_TIKTOK_ACCESS_TOKEN=
NIGHT_ACC3_IG_USER_ID=
NIGHT_ACC3_IG_ACCESS_TOKEN=
